# Copy this file to .env and fill in the values.

# Your Claude API key from https://console.anthropic.com (required for scene writing)
ANTHROPIC_API_KEY=sk-ant-...

# Password for the whole app (user name + password the browser asks for). Leave empty to turn it off.
APP_USER=admin
APP_PASSWORD=change-me

# Models. "Best quality" (complex) gives the output closest to the chat.
MODEL_BEST=claude-opus-5-5
MODEL_FAST=claude-sonnet-5-5
DEFAULT_TIER=complex
MAX_TOKENS=32000

# Safety limit: scene/analysis calls allowed per hour from one address
GEN_PER_HOUR=60

PORT=3000
DATA_DIR=data
