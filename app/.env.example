# Copy this file to .env and fill in the values.

# Your Claude API key from https://console.anthropic.com (required for scene writing)
ANTHROPIC_API_KEY=sk-ant-...

# Password for the whole app (user name + password the browser asks for). Leave empty to turn it off.
APP_USER=admin
APP_PASSWORD=change-me

# Models. "Best quality" (complex) gives the output closest to the chat.
MODEL_BEST=claude-opus-5-5
MODEL_FAST=claude-sonnet-5-5
DEFAULT_TIER=complex
MAX_TOKENS=32000

# Safety limit: scene/analysis calls allowed per hour from one address
GEN_PER_HOUR=60

PORT=3000
DATA_DIR=data

# ---- Backup AI (optional) -------------------------------------------------
# Used automatically when Claude can't answer (no credit, key expired, outage).
# Any OpenAI-compatible chat API works. Pick ONE provider, fill in all three:
#   OpenAI:         FALLBACK_BASE_URL=https://api.openai.com/v1
#   Google Gemini:  FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter:     FALLBACK_BASE_URL=https://openrouter.ai/api/v1
#   Ollama (own):   FALLBACK_BASE_URL=http://localhost:11434/v1   (no key needed)
# FALLBACK_MODEL = a current model name from that provider's model list.
# The scene request is long (~140 KB), so choose a model with a large context window.
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=
FALLBACK_MAX_TOKENS=16000
